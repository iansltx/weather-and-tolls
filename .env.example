# Copy to .env (gitignored) and fill in.

# OpenWeather API key for the server-side weather lookups (required)
OPENWEATHER_API_KEY=your_openweather_key

# Default location used when the page does not pass ?location=
DEFAULT_WEATHER_LOCATION=Austin, TX, US

# Automatic weather/toll refresh interval in seconds
KIOSK_REFRESH_SECONDS=300

# Mercure JWT signing keys; publisher publishes, subscriber authorizes the
# subscription listing API used for connected-client detection
MERCURE_PUBLISHER_JWT_KEY=change-me-publisher-key
MERCURE_SUBSCRIBER_JWT_KEY=change-me-subscriber-key

# Host port for the web server
KIOSK_PORT=8080

# Overrides for API testing (defaults match the terminal UI)
#OPENWEATHER_BASE_URL=
#TOLL_RATES_URL=